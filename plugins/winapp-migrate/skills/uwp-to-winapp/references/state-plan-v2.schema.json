{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/microsoft/winapp-migrate/state-plan-v2.schema.json",
  "title": "Immutable migration verification plan",
  "description": "Structural schema. seal-contract additionally checks cross references, ordered coverage, append-only extension, independent local anchoring and pre-source/workflow timing.",
  "type": "object",
  "required": ["schemaVersion", "states"],
  "properties": {
    "schemaVersion": { "const": "2.0" },
    "states": {
      "type": "array", "minItems": 1,
      "items": { "$ref": "#/$defs/state" }
    }
  },
  "$defs": {
    "region": {
      "type": "object",
      "required": ["x", "y", "width", "height"],
      "additionalProperties": false,
      "properties": {
        "x": { "type": "number", "minimum": 0, "maximum": 1 },
        "y": { "type": "number", "minimum": 0, "maximum": 1 },
        "width": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
        "height": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 }
      }
    },
    "assertion": {
      "type": "object",
      "required": ["id", "kind", "probeIndex", "sourceEvidence"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["ui-property-equals-source", "visual-region-equals-source"] },
        "probeIndex": { "type": "integer", "minimum": 0 },
        "sourceEvidence": { "type": "string", "minLength": 1 },
        "automationId": { "type": "string" },
        "selector": { "type": ["string", "null"] },
        "property": { "enum": ["", "name", "value", "isSelected", "hasKeyboardFocus", "isEnabled", "isOffscreen", "expandState", "toggleState"] },
        "region": { "oneOf": [{ "$ref": "#/$defs/region" }, { "type": "null" }] },
        "sourceRegion": { "oneOf": [{ "$ref": "#/$defs/region" }, { "type": "null" }] },
        "boundsEvidence": { "type": ["string", "null"] },
        "boundsProbeIndex": { "type": ["integer", "null"], "minimum": 0 },
        "boundsAfterProbeIndex": { "type": ["integer", "null"], "minimum": 0 },
        "sourceCaptureEvidence": { "type": ["string", "null"] },
        "sufficiency": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "properties": {
            "minimumContentFraction": { "type": "number", "exclusiveMinimum": 0, "maximum": 0.5 },
            "minimumDistinctColors": { "type": "integer", "minimum": 2, "maximum": 4096 },
            "minimumSamplePixels": { "type": "integer", "minimum": 4, "maximum": 16777216 }
          }
        },
        "comparison": { "enum": ["pixel-exact", "sampled-mae"] },
        "maximumMeanError": { "type": "number", "minimum": 0, "maximum": 0.1 }
      }
    },
    "verification": {
      "type": "object",
      "required": ["kind", "requiredActions", "steps"],
      "additionalProperties": false,
      "properties": {
        "kind": { "enum": ["nonvisual", "visual"] },
        "requiredActions": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "required": ["id", "command"], "additionalProperties": false,
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "command": { "type": "array", "minItems": 1, "items": { "type": "string" } }
            }
          }
        },
        "steps": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "required": ["kind", "id"], "additionalProperties": false,
            "properties": { "kind": { "enum": ["action", "assertion"] }, "id": { "type": "string", "minLength": 1 } }
          }
        },
        "restorations": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "baselineAssertionId", "returnActionId", "restoredAssertionId"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "baselineAssertionId": { "type": "string", "minLength": 1 },
              "returnActionId": { "type": "string", "minLength": 1 },
              "restoredAssertionId": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "observation": {
      "type": "object", "required": ["status"],
      "properties": {
        "status": { "type": "string" },
        "reason": { "type": ["string", "null"] },
        "evidence": { "type": "array", "items": { "type": "string" } },
        "attestation": { "type": ["string", "null"] },
        "verificationLevel": { "type": ["string", "null"], "enum": [null, "evidence-valid", "contract-satisfied", "parity-verified"] }
      }
    },
    "state": {
      "type": "object",
      "required": ["id", "actions", "expectedOutcome", "assertions", "verification", "source", "target", "comparison"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "slice": { "type": ["string", "null"] },
        "dependencies": { "type": "array", "items": { "type": "string" } },
        "criticality": { "enum": ["required", "optional"] },
        "featurePaths": { "type": "array", "items": { "type": "string" } },
        "preconditions": { "type": "array", "items": { "type": "string" } },
        "actions": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "expectedOutcome": { "type": "string", "minLength": 1 },
        "assertions": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/assertion" } },
        "verification": { "$ref": "#/$defs/verification" },
        "source": {
          "allOf": [
            { "$ref": "#/$defs/observation" },
            { "properties": { "status": { "enum": ["not-run", "captured", "blocked", "unverified"] } } }
          ]
        },
        "target": {
          "allOf": [
            { "$ref": "#/$defs/observation" },
            { "properties": { "status": { "enum": ["not-run", "passed", "blocked", "unverified", "failed"] } } }
          ]
        },
        "comparison": {
          "allOf": [
            { "$ref": "#/$defs/observation" },
            { "properties": { "status": { "enum": ["not-run", "verified", "blocked", "unverified", "failed"] } } }
          ]
        }
      }
    }
  }
}
